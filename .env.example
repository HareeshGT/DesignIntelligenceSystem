# Optional LLM configuration. Leave DIS_LLM_API_KEY empty for deterministic mode.
# Supported providers: openai, anthropic, openai-compatible, groq, gemini, mistral, openrouter
DIS_LLM_PROVIDER=openai
DIS_LLM_API_KEY=
DIS_LLM_MODEL=gpt-4o-mini

# Optional custom OpenAI-compatible or Anthropic API base URL.
# Examples:
# DIS_LLM_BASE_URL=https://api.groq.com/openai/v1
# DIS_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# DIS_LLM_BASE_URL=https://api.mistral.ai/v1
# DIS_LLM_BASE_URL=https://openrouter.ai/api/v1
# For Anthropic, the default base URL is https://api.anthropic.com/v1.
DIS_LLM_BASE_URL=
