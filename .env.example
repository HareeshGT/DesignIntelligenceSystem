# Optional LLM configuration. Leave DIS_LLM_API_KEY empty for deterministic mode.
# Supported providers: openai, anthropic, openai-compatible, groq, gemini, mistral, openrouter
DIS_LLM_PROVIDER=openai
DIS_LLM_API_KEY=
DIS_LLM_MODEL=gpt-4o-mini

# Optional custom OpenAI-compatible or Anthropic API base URL.
# Examples:
# DIS_LLM_BASE_URL=https://api.groq.com/openai/v1
# DIS_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# DIS_LLM_BASE_URL=https://api.mistral.ai/v1
# DIS_LLM_BASE_URL=https://openrouter.ai/api/v1
# For Anthropic, the default base URL is https://api.anthropic.com/v1.
DIS_LLM_BASE_URL=

# Protect the inspection endpoint when DIS uses credentials or a paid LLM provider.
# If DIS_GITHUB_TOKEN or an LLM API key is set, configure this and send it as X-DIS-API-Key.
DIS_REPOSITORY_INSPECTION_API_KEY=

# Required for signed UI proposals; generate a separate server-only random secret.
# Never reuse the browser-facing DIS_REPOSITORY_INSPECTION_API_KEY.
DIS_PROPOSAL_SIGNING_KEY= # generate a unique random value with at least 32 bytes

# Optional GitHub token for private repositories / higher API limits.
# Use a least-privilege fine-grained token with read-only Contents access.
DIS_GITHUB_TOKEN=

# Optional GitHub write token used only after an explicit UI patch approval.
# Fine-grained token permissions: Contents (read/write), Pull requests (read/write).
# Keep DIS_GITHUB_TOKEN read-only for inspection; do not reuse a broad personal token.
DIS_GITHUB_WRITE_TOKEN=

# Optional dedicated multimodal model settings. When omitted, visual analysis uses DIS_LLM_*.
# Choose a model that accepts image inputs. Screenshots are sent only after user opt-in.
DIS_VISION_LLM_PROVIDER=
DIS_VISION_LLM_API_KEY=
DIS_VISION_LLM_MODEL=
DIS_VISION_LLM_BASE_URL=

